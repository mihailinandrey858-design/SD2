# Скопируй этот файл в .env и заполни значения: cp .env.example .env
# Сервер читает .env автоматически при запуске.

# Сетевые настройки
HOST=0.0.0.0
PORT=3000

# Публичный адрес сайта (используется в ссылках сброса пароля).
# Если не задан, адрес берётся из заголовков запроса.
# Примеры: http://123.45.67.89:3000 или https://sdonate.example.com
PUBLIC_BASE_URL=

# Первичный администратор (нужен только при первом запуске)
SDONATE_ADMIN_EMAIL=
SDONATE_ADMIN_PASSWORD=
SDONATE_ADMIN_NICKNAME=Andrey11

# Почта для сброса пароля (SMTP). Если не задано, ссылка сброса пишется в лог.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Telegram-уведомления о заявках на верификацию (оба значения сразу или ни одного)
SDONATE_TELEGRAM_BOT_TOKEN=
SDONATE_TELEGRAM_CHAT_ID=

# Google reCAPTCHA v2 ("Я не робот") на входе и регистрации.
# Ключи берутся на https://www.google.com/recaptcha/admin/create
# В список доменов добавь: 109.238.93.205 и свой домен (если будет)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
